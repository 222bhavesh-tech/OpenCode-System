{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "C:\\Users\\bhavesh jeengar\\Documents"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp",
      "enabled": false,
      "oauth": true,
      "description": "Figma design context — DISABLED (requires Figma Dev/Full seat + OAuth). NOT FREE."
    },
    "google-flow": {
      "type": "local",
      "command": ["node", "C:\\Users\\bhavesh jeengar\\.config\\opencode\\google-flow-mcp\\dist\\index.js"],
      "enabled": false,
      "description": "Google Flow MCP — DISABLED (requires Chrome CDP + real Google email). NOT FREE."
    },
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
      },
      "enabled": true,
      "description": "Web scraping (keyless free: scrape/search/parse). Crawl/map/agent require API key."
    },
    "computer-use": {
      "type": "local",
      "command": ["npx", "-y", "open-computer-use", "mcp"],
      "enabled": false,
      "description": "Desktop control — DISABLED (requires Docker). NOT FREE."
    },
    "chirpie": {
      "type": "local",
      "command": ["npx", "-y", "@chirpie/mcp"],
      "enabled": true,
      "description": "Social media posting to 14 platforms including Facebook, X, LinkedIn, Instagram, Telegram. Requires chirpie login."
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true,
      "description": "Step-by-step reasoning and problem solving. Enhances agent reasoning quality."
    },
    "fetch": {
      "type": "local",
      "command": ["npx", "-y", "mcp-fetch-server"],
      "enabled": true,
      "description": "Fetch web content as HTML, Markdown, plain text, JSON, or YouTube transcripts."
    },
    "wordpress": {
      "type": "local",
      "command": ["npx", "-y", "@cmsmcp/wordpress"],
      "enabled": true,
      "description": "WordPress CMS management — posts, pages, media, users, comments. 337 tools."
    },
    "woocommerce": {
      "type": "local",
      "command": ["npx", "-y", "@cmsmcp/woocommerce"],
      "enabled": true,
      "description": "WooCommerce store management — products, orders, customers, coupons. 95 tools."
    },
    "shopify": {
      "type": "local",
      "command": ["npx", "-y", "@cmsmcp/shopify"],
      "enabled": true,
      "description": "Shopify store management — products, orders, customers, inventory. 147 tools."
    }
  }
}
